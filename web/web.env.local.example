# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# Never put secrets (client secrets, API keys with write access) in this file.

NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# The app's own deployed origin — used for metadataBase (resolving relative
# Open Graph/Twitter image URLs). Defaults to local dev if left blank; set to
# the real Vercel/production URL once one exists.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Safe to expose — this is the public client ID, not the secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_FACEBOOK_APP_ID=""

# Client-side Places Autocomplete widget key — restrict this one by HTTP
# referrer (your domain) in Google Cloud Console, NOT by IP, since it's used
# from the browser. Separate from GOOGLE_MAPS_SERVER_API_KEY (server/.env),
# which is IP-restricted and used server-side for geocoding. Requires
# Places API (New) enabled on a billing-enabled Google Cloud project.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Optional — leave blank to skip frontend error tracking
NEXT_PUBLIC_SENTRY_DSN=""
