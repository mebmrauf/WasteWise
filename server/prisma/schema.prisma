generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                                    String                      @id @default(cuid())
  email                                 String                      @unique
  phone                                 String?                     @unique
  passwordHash                          String?
  fullName                              String
  role                                  Role                        @default(USER)
  isEmailVerified                       Boolean                     @default(false)
  createdAt                             DateTime                    @default(now())
  updatedAt                             DateTime                    @updatedAt
  accountType                           AccountType?
  avatarUrl                             String?
  emailNotificationsEnabled             Boolean                     @default(true)
  smsNotificationsEnabled               Boolean                     @default(true)
  formattedAddress                      String?
  latitude                              Float?
  longitude                             Float?
  placeId                               String?
  greenPointsBalance                    Int                         @default(0)
  discountCouponClaimed                 Boolean                     @default(false)
  giftClaimDate                         DateTime?
  giftClaimed                           Boolean                     @default(false)
  lastDiscountClaimDate                 DateTime?
  membershipBadge                       String                      @default("Bronze Badge")
  membershipLevel                       MembershipLevel             @default(BRONZE)
  milestonesClaimed                     Int[]                       @default([])
  nextDiscountEligibleDate              DateTime?
  nextGiftEligibleDate                  DateTime?
  referralCode                          String?                     @unique
  referralPointsEarned                  Int                         @default(0)
  referralRewardClaimed                 Boolean                     @default(false)
  referredById                          String?
  selectedGift                          PlatinumGift?
  successfulReferrals                   Int                         @default(0)
  totalGreenPoints                      Int                         @default(0)
  lastTreePlantationClaimDate           DateTime?
  nextTreePlantationEligibleDate        DateTime?
  sustainabilityCertificateUrl          String?
  treePlantationClaimed                 Boolean                     @default(false)
  emailVerificationReminderSentAt       DateTime?
  rewardsEmailNotificationsEnabled      Boolean                     @default(true)
  bulkRequestsAssigned                  BulkMarketplaceRequest[]    @relation("AssignedCompany")
  bulkRequestsMade                      BulkMarketplaceRequest[]    @relation("BusinessRequests")
  businessProfile                       BusinessProfile?            @relation("BusinessProfileUser")
  businessVerificationsReviewed         BusinessProfile[]           @relation("BusinessVerificationReviewer")
  collectorProfile                      CollectorProfile?           @relation("CollectorProfileUser")
  collectorVerificationsReviewed        CollectorProfile[]          @relation("CollectorVerificationReviewer")
  complaintsAgainst                     Complaint[]                 @relation("ComplaintTarget")
  complaintsFiled                       Complaint[]                 @relation("ComplaintFiler")
  complaintsResolved                    Complaint[]                 @relation("ComplaintResolver")
  sentMessages                          Message[]                   @relation("SentMessages")
  receivedMessages                      Message[]                   @relation("ReceivedMessages")
  emailVerificationCodes                EmailVerificationCode[]
  greenPointsTransactions               GreenPointsTransaction[]    @relation("GreenPointsTransactions")
  marketplaceQuotations                 MarketplaceQuotation[]      @relation("CompanyQuotations")
  mobileRechargeTransactions            MobileRechargeTransaction[] @relation("MobileRechargeTransactions")
  notifications                         Notification[]
  oauthAccounts                         OAuthAccount[]
  offers                                Offer[]                     @relation("CollectorOffers")
  passwordResetCodes                    PasswordResetCode[]
  pickupRequestsAssigned                PickupRequest[]             @relation("AssignedCollector")
  pickupRequestsMade                    PickupRequest[]             @relation("PickupRequester")
  ratingsReceived                       Rating[]                    @relation("CollectorRatings")
  ratingsGiven                          Rating[]                    @relation("RaterRatings")
  recyclingCompanyProfile               RecyclingCompanyProfile?    @relation("RecyclingCompanyProfileUser")
  recyclingCompanyVerificationsReviewed RecyclingCompanyProfile[]   @relation("RecyclingCompanyVerificationReviewer")
  refreshTokens                         RefreshToken[]
  referredBy                            User?                       @relation("Referrals", fields: [referredById], references: [id])
  referredUsers                         User[]                      @relation("Referrals")
  routePlans                            RoutePlan[]                 @relation("CollectorRoutePlans")
  wasteRecognitionLogs                  WasteRecognitionLog[]
  weightRecordsLogged                   WeightRecord[]              @relation("WeightLogger")
  ignoredPickups                        PickupRequest[]             @relation("IgnoredPickups")
  csrContributions                      CsrContribution[]           @relation("BusinessCsrContributions")
  paymentsReceived                      Payment[]                   @relation("PaymentsReceived")
  paymentsMade                          Payment[]                   @relation("PaymentsMade")
  wasteAnalysisReportsRequested         WasteAnalysisReport[]       @relation("WasteAnalysisRequester")
  wasteAnalysisReportsReviewed          WasteAnalysisReport[]       @relation("WasteAnalysisReviewer")
  communityName                 String?
  hasJoinedCampaignCommunity     Boolean               @default(false)
  campaignCommunityJoinedAt      DateTime?
  campaignNotificationsEnabled   Boolean               @default(true)
  campaignsCreated               RecyclingCampaign[]   @relation("CampaignsCreated")
  campaignRegistrations          CampaignRegistration[]
  campaignVideosUploaded         CampaignVideo[]        @relation("CampaignVideoUploader")
}

model OAuthAccount {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String
  userId            String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetCode {
  id         String    @id @default(cuid())
  userId     String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CollectorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("CollectorProfileUser", fields: [userId], references: [id], onDelete: Cascade)

  vehicleType   VehicleType
  vehicleNumber String      @default("")
  licenseNumber String      @default("")

  serviceArea String @default("")

  // Radius-based service coverage: collector sets a base point + radius (km).
  // Pickup requests within that radius surface to them / trigger a notification.
  serviceAreaPlaceId          String?
  serviceAreaFormattedAddress String?
  serviceAreaLatitude         Float?
  serviceAreaLongitude        Float?
  serviceAreaRadiusKm         Float?

  verificationStatus            VerificationStatus @default(PENDING)
  verificationDocumentUrl       String?
  verificationReviewedAt        DateTime?
  verificationReviewedByAdminId String?
  verificationRejectionReason   String?
  averageRating                 Float?
  totalRatings                  Int                @default(0)
  lastKnownLatitude             Float?
  lastKnownLongitude            Float?
  lastLocationUpdatedAt         DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  verificationReviewedByAdmin   User?              @relation("CollectorVerificationReviewer", fields: [verificationReviewedByAdminId], references: [id])
}

model RecyclingCompanyProfile {
  id                            String             @id @default(cuid())
  userId                        String             @unique
  companyName                   String
  district                      String
  currentInventoryKg            Float              @default(0)
  verificationStatus            VerificationStatus @default(PENDING)
  verificationDocumentUrl       String?
  verificationReviewedAt        DateTime?
  verificationReviewedByAdminId String?
  verificationRejectionReason   String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  acceptedWasteMaterials        WasteCategory[]
  serviceAreas                  String[]
  tradeLicenseNumber            String?
  user                          User               @relation("RecyclingCompanyProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  verificationReviewedByAdmin   User?              @relation("RecyclingCompanyVerificationReviewer", fields: [verificationReviewedByAdminId], references: [id])
}

model BusinessProfile {
  id                            String             @id @default(cuid())
  userId                        String             @unique
  businessName                  String
  tradeLicenseNumber            String?
  verificationStatus            VerificationStatus @default(PENDING)
  verificationDocumentUrl       String?
  verificationReviewedAt        DateTime?
  verificationReviewedByAdminId String?
  verificationRejectionReason   String?
  askForCsrContribution         Boolean            @default(false)
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  user                          User               @relation("BusinessProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  verificationReviewedByAdmin   User?              @relation("BusinessVerificationReviewer", fields: [verificationReviewedByAdminId], references: [id])
}

model PickupRequest {
  id                      String                   @id @default(cuid())
  requesterId             String
  assignedCollectorId     String?
  pickupDate              DateTime                 @map("timeSlotStart")
  timeSlotEnd             DateTime?                @ignore
  status                  PickupStatus             @default(PENDING)
  latitude                Float?
  longitude               Float?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  pickupFormattedAddress  String
  placeId                 String
  isExclusiveToPreferred  Boolean                  @default(false)
  preferredCollectorId    String?
  serviceArea             String?
  isBulk                  Boolean                  @default(false)
  photoUrls               String[]                 @default([])
  wasteDescription        String?
  complaints              Complaint[]
  greenPointsTransactions GreenPointsTransaction[]
  notifications           Notification[]
  offers                  Offer[]
  routeStops              RouteStop[]
  assignedCollector       User?                    @relation("AssignedCollector", fields: [assignedCollectorId], references: [id])
  requester               User                     @relation("PickupRequester", fields: [requesterId], references: [id])
  items                   PickupRequestItem[]
  trackingEvents          PickupTrackingEvent[]
  rating                  Rating?
  weightRecord            WeightRecord?
  payments                Payment[]
  ignoredByCollectors     User[]                   @relation("IgnoredPickups")
  wasteAnalysisReports    WasteAnalysisReport[]
  @@index([status])
  @@index([assignedCollectorId])
  @@index([requesterId, createdAt])
}

model PickupRequestItem {
  id              String        @id @default(cuid())
  pickupRequestId String
  category        WasteCategory
  loadSize        LoadSize
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  exactWeightKg   Float?
  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)

  @@unique([pickupRequestId, category])
  @@index([pickupRequestId])
}

model Offer {
  id              String        @id @default(cuid())
  pickupRequestId String
  collectorId     String
  bidAmount       Float
  status          OfferStatus   @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  message         String?
  bidAmountsPerKg Json?
  collector       User          @relation("CollectorOffers", fields: [collectorId], references: [id])
  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)

  @@unique([pickupRequestId, collectorId])
  @@index([collectorId])
}

model PickupTrackingEvent {
  id              String        @id @default(cuid())
  pickupRequestId String
  status          PickupStatus
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)

  @@index([pickupRequestId])
}

model WeightRecord {
  id                  String        @id @default(cuid())
  pickupRequestId     String        @unique
  estimatedMinKg      Float
  estimatedMaxKg      Float
  exactWeightKg       Float?
  loggedAt            DateTime?
  loggedByCollectorId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  loggedByCollector   User?         @relation("WeightLogger", fields: [loggedByCollectorId], references: [id])
  pickupRequest       PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
}

model Rating {
  id              String                  @id @default(cuid())
  pickupRequestId String?                 @unique
  raterId         String
  collectorId     String
  score           Int
  comment         String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  bulkRequestId   String?                 @unique
  bulkRequest     BulkMarketplaceRequest? @relation(fields: [bulkRequestId], references: [id], onDelete: Cascade)
  collector       User                    @relation("CollectorRatings", fields: [collectorId], references: [id])
  pickupRequest   PickupRequest?          @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  rater           User                    @relation("RaterRatings", fields: [raterId], references: [id])
}

model Complaint {
  id                String                  @id @default(cuid())
  pickupRequestId   String?
  bulkRequestId     String?
  complainantId     String
  againstUserId     String?
  description       String
  status            ComplaintStatus         @default(OPEN)
  resolutionNotes   String?
  resolvedAt        DateTime?
  resolvedByAdminId String?
  photos            String[]                @default([])
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  againstUser       User?                   @relation("ComplaintTarget", fields: [againstUserId], references: [id])
  complainant       User                    @relation("ComplaintFiler", fields: [complainantId], references: [id])
  pickupRequest     PickupRequest?          @relation(fields: [pickupRequestId], references: [id])
  bulkRequest       BulkMarketplaceRequest? @relation(fields: [bulkRequestId], references: [id])
  resolvedByAdmin   User?                   @relation("ComplaintResolver", fields: [resolvedByAdminId], references: [id])

  @@index([status])
}

model Notification {
  id                     String           @id @default(cuid())
  userId                 String
  type                   NotificationType
  title                  String
  message                String
  isRead                 Boolean          @default(false)
  relatedPickupRequestId String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  relatedPickupRequest   PickupRequest?   @relation(fields: [relatedPickupRequestId], references: [id])
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model WasteRecognitionLog {
  id               String        @id @default(cuid())
  userId           String
  imageUrl         String
  detectedCategory WasteCategory
  isRecyclable     Boolean
  confidence       Float
  rawLabels        Json
  preparationTip   String?
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WasteAnalysisReport {
  id                   String                    @id @default(cuid())
  pickupRequestId      String?
  bulkRequestId        String?
  requesterId          String
  photoUrls            String[]                  @default([])
  description          String?
  visionLabels         Json?
  detectedCondition    WasteItemCondition?
  estimatedUsagePeriod WasteUsagePeriod?
  suggestedCategory    WasteCategory?
  confidence           Float?
  aiSummary            String?
  needsAdminReview     Boolean                   @default(true)
  reviewReason         String?
  reviewStatus         WasteAnalysisReviewStatus @default(PENDING)
  reviewedAt           DateTime?
  reviewedByAdminId    String?
  reviewNotes          String?
  createdAt            DateTime                  @default(now())
  pickupRequest        PickupRequest?            @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  bulkRequest          BulkMarketplaceRequest?   @relation(fields: [bulkRequestId], references: [id], onDelete: Cascade)
  requester            User                      @relation("WasteAnalysisRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewedByAdmin      User?                     @relation("WasteAnalysisReviewer", fields: [reviewedByAdminId], references: [id])

  @@index([reviewStatus])
  @@index([pickupRequestId])
  @@index([bulkRequestId])
}

model GreenPointsTransaction {
  id                        String                     @id @default(cuid())
  userId                    String
  pickupRequestId           String?
  points                    Int
  type                      GreenPointsTransactionType
  description               String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  basePoints                Int?
  bonusPoints               Int?
  category                  TransactionCategory        @default(OTHER)
  rewardReason              Json?
  totalPoints               Int?
  pickupRequest             PickupRequest?             @relation(fields: [pickupRequestId], references: [id])
  user                      User                       @relation("GreenPointsTransactions", fields: [userId], references: [id], onDelete: Cascade)
  mobileRechargeTransaction MobileRechargeTransaction?

  @@index([userId])
  @@index([userId, createdAt])
}

model MobileRechargeTransaction {
  id                       String                  @id @default(cuid())
  userId                   String
  operator                 MobileOperator
  simType                  SimType
  phoneNumber              String
  amountTaka               Int
  pointsSpent              Int
  status                   MobileRechargeStatus
  greenPointsTransactionId String?                 @unique
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  greenPointsTransaction   GreenPointsTransaction? @relation(fields: [greenPointsTransactionId], references: [id])
  user                     User                    @relation("MobileRechargeTransactions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BulkMarketplaceRequest {
  id                    String                 @id @default(cuid())
  businessId            String
  assignedCompanyId     String?
  wasteTypes            Json
  estimatedWeightKg     Float
  pickupAddress         String
  latitude              Float?
  longitude             Float?
  placeId               String?
  preferredPickupDate   DateTime
  images                String[]
  additionalNotes       String?
  status                BulkRequestStatus      @default(OPEN_FOR_BIDDING)
  bidEndsAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  collectionPhotos      String[]
  verifiedTotalWeightKg Float?
  verifiedWeights       Json?
  assignedCompany       User?                  @relation("AssignedCompany", fields: [assignedCompanyId], references: [id])
  business              User                   @relation("BusinessRequests", fields: [businessId], references: [id])
  quotations            MarketplaceQuotation[]
  rating                Rating?
  csrContributions      CsrContribution[]
  complaints            Complaint[]
  payments              Payment[]
  wasteAnalysisReports  WasteAnalysisReport[]

  @@index([businessId])
  @@index([status])
}

model MarketplaceQuotation {
  id                  String                 @id @default(cuid())
  requestId           String
  companyId           String
  purchasePrice       Float
  vehicleType         VehicleType
  estimatedPickupDate DateTime
  estimatedPickupTime String?
  additionalNotes     String?
  status              QuotationStatus        @default(PENDING)
  isHighestBid        Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  pricesPerKg         Json?
  company             User                   @relation("CompanyQuotations", fields: [companyId], references: [id])
  request             BulkMarketplaceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, companyId])
  @@index([companyId])
}

enum Role {
  USER
  COLLECTOR
  RECYCLING_COMPANY
  ADMIN
}

enum MembershipLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PlatinumGift {
  TREE_SAPLING
  ECO_TOTE_BAG
  REUSABLE_WATER_BOTTLE
}

enum AccountType {
  HOUSEHOLD
  BUSINESS
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleType {
  HANDCART
  BICYCLE_VAN
  MOTORCYCLE_VAN
  PICKUP_TRUCK
  TRUCK
}

enum RoutePlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RouteStopStatus {
  QUEUED
  VISITED
  SKIPPED
}

model RoutePlan {
  id              String          @id @default(cuid())
  collectorId     String
  status          RoutePlanStatus @default(ACTIVE)
  originLatitude  Float
  originLongitude Float
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  collector       User            @relation("CollectorRoutePlans", fields: [collectorId], references: [id], onDelete: Cascade)
  stops           RouteStop[]

  @@index([collectorId, status])
}

model RouteStop {
  id              String          @id @default(cuid())
  routePlanId     String
  pickupRequestId String
  sequence        Int
  status          RouteStopStatus @default(QUEUED)
  visitedAt       DateTime?
  skippedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  routePlan       RoutePlan       @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  pickupRequest   PickupRequest   @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)

  @@unique([routePlanId, pickupRequestId])
  @@index([routePlanId, sequence])
  @@index([pickupRequestId])
}

enum WasteCategory {
  PLASTIC
  PAPER
  ORGANIC
  GLASS
  METAL
  ELECTRONIC
  OTHER
}

enum LoadSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum PickupStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
  VERIFYING_WEIGHTS
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BulkRequestStatus {
  OPEN_FOR_BIDDING
  BIDDING_CLOSED
  RECYCLING_COMPANY_ASSIGNED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  VERIFYING_WEIGHTS
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum WasteAnalysisReviewStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum WasteItemCondition {
  NEW
  LIGHTLY_USED
  MODERATELY_USED
  HEAVILY_USED
  DAMAGED
  BROKEN
  UNKNOWN
}

enum WasteUsagePeriod {
  UNDER_6_MONTHS
  SIX_MONTHS_TO_1_YEAR
  ONE_TO_3_YEARS
  THREE_TO_5_YEARS
  OVER_5_YEARS
  UNKNOWN
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  PICKUP_STATUS_UPDATE
  OFFER_RECEIVED
  REMINDER
  VERIFICATION_UPDATE
  COMPLAINT_UPDATE
  ROUTE_UPDATE
  GENERIC
  CAMPAIGN_UPDATE
}

enum GreenPointsTransactionType {
  EARNED
  REDEEMED
}

enum TransactionCategory {
  PICKUP
  BONUS
  REFERRAL
  LOYALTY
  REDEMPTION
  CSR_CONTRIBUTION
  OTHER
}

enum MobileOperator {
  GRAMEENPHONE
  BANGLALINK
  ROBI
  AIRTEL
  TELETALK
}

enum SimType {
  PREPAID
  POSTPAID
}

enum MobileRechargeStatus {
  SUCCESS
  FAILED
}

model CsrContribution {
  id                 String   @id @default(cuid())
  businessId         String
  pickupId           String
  donationAmount     Float
  donationPercentage Float?
  selectedCause      String
  paymentAmount      Float
  status             CsrStatus @default(PENDING)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business User                   @relation("BusinessCsrContributions", fields: [businessId], references: [id], onDelete: Cascade)
  pickup   BulkMarketplaceRequest @relation(fields: [pickupId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([pickupId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  pickupId      String? // For smart pickups
  bulkRequestId String? // For bulk pickups
  customerId    String // The user/business receiving payment
  payerId       String // The collector/recycling company making payment
  amount        Float
  paymentMethod PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String? // For SSLCommerz
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer    User                    @relation("PaymentsReceived", fields: [customerId], references: [id])
  payer       User                    @relation("PaymentsMade", fields: [payerId], references: [id])
  pickup      PickupRequest?          @relation(fields: [pickupId], references: [id])
  bulkRequest BulkMarketplaceRequest? @relation(fields: [bulkRequestId], references: [id])

  @@index([customerId])
  @@index([payerId])
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  SSLCOMMERZ
  COD
  NOT_SELECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum CsrStatus {
  PENDING
  COMPLETED
}
enum CampaignRegistrationType {
  ATTENDEE
  VOLUNTEER
}

model RecyclingCampaign {
  id               String   @id @default(cuid())
  title            String
  description      String?
  location         String?
  eventDate        DateTime
  volunteersNeeded Int?
  coverImageUrl    String?
  createdByAdminId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdByAdmin User                   @relation("CampaignsCreated", fields: [createdByAdminId], references: [id])
  registrations  CampaignRegistration[]
  videos         CampaignVideo[]

  @@index([eventDate])
}

model CampaignRegistration {
  id           String                    @id @default(cuid())
  campaignId   String
  userId       String
  type         CampaignRegistrationType
  registeredAt DateTime                  @default(now())

  campaign RecyclingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, type])
  @@index([campaignId])
  @@index([userId])
}

model CampaignVideo {
  id                String   @id @default(cuid())
  campaignId        String?
  title             String
  description       String?
  videoUrl          String
  thumbnailUrl      String?
  uploadedByAdminId String
  createdAt         DateTime @default(now())

  campaign        RecyclingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  uploadedByAdmin User               @relation("CampaignVideoUploader", fields: [uploadedByAdminId], references: [id])

  @@index([campaignId])
}