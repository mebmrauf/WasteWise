# Test environment fixture — loaded by server/vitest.setup.ts.
# All values here are dummy/fake. Never put real secrets in this file (it is
# committed to the repo, unlike server/.env which is gitignored).
#
# DATABASE_URL below is a harmless placeholder — it only needs to be real for
# the one test that actually hits a database (tests/resetDatabase.test.ts).
# In CI, a Postgres service container (see ci.yml) provides a real database
# automatically. To run that test locally, create a spare/free Neon project
# or branch for testing and put its real connection string in a new
# server/.env.test.local file (gitignored, never committed) — it overrides
# this DATABASE_URL automatically. No local Postgres/Docker install needed.

NODE_ENV="test"
PORT=4001
CLIENT_ORIGIN="http://localhost:3000"

DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/wastewise_test?schema=public"

JWT_ACCESS_SECRET="test-only-access-secret-not-real-0000"
JWT_REFRESH_SECRET="test-only-refresh-secret-not-real-0000"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Dummy OAuth config — enables exercising the /google and /facebook redirect
# routes in tests without ever making a real request to Google/Facebook
# (the test suite never supplies a real authorization `code`, so the token
# exchange step is never reached).
GOOGLE_CLIENT_ID="test-google-client-id"
GOOGLE_CLIENT_SECRET="test-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4001/api/v1/auth/google/callback"
FACEBOOK_APP_ID="test-facebook-app-id"
FACEBOOK_APP_SECRET="test-facebook-app-secret"
FACEBOOK_CALLBACK_URL="http://localhost:4001/api/v1/auth/facebook/callback"

LOG_LEVEL="silent"
