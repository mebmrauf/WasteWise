# --- Database ---
# WasteWise uses NeonDB (managed Postgres) for both dev and prod — grab the
# pooled connection string from your Neon project dashboard. sslmode=require
# is mandatory; channel_binding=require is what Neon's dashboard gives you by
# default.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
SHADOW_DATABASE_URL=""
# --- App ---
NODE_ENV="development"
PORT=4000
# Comma-separated list of allowed CORS origins (no trailing slashes).
CLIENT_ORIGIN="http://localhost:3000"

# --- Auth (JWT) ---
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# --- OAuth: Facebook ---
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CALLBACK_URL="http://localhost:4000/api/v1/auth/facebook/callback"

# --- Google Maps (server-side geocoding) ---
# Separate from NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (web/web.env.local.example) —
# this key is used server-side only (Geocoding API, to convert/verify an
# address into lat/lng) and should be IP-restricted in Google Cloud Console,
# never exposed to the browser. Requires Places API (New) + Geocoding API
# enabled on a billing-enabled Google Cloud project (Google requires a card
# on file even for free-tier usage) — see docs/api-contract.md if a "Google
# Maps" section exists there once this is wired up.
GOOGLE_MAPS_SERVER_API_KEY=""

# --- AI Vision (Waste Recognition) ---
GOOGLE_VISION_API_KEY=""

# --- Cloudinary (avatar image storage) ---
# CLOUDINARY_CLOUD_NAME must match NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME in
# web/.env.local — the frontend builds the display URL from the cloud name
# plus the public_id the server stores on User.avatarUrl.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (forgot-password verification codes) ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

#Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=